{
  "name": "furescue-frontend",
  "version": "1.0.0",
  "description": "FurEscue landing page — Tailwind CLI build with shadcn-style UI primitives (no framework).",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-vendor.mjs && node scripts/build-lucide.mjs && tailwindcss -i ./public/assets/css/input.css -o ./public/assets/css/style.css --minify",
    "build:vendor": "node scripts/build-vendor.mjs",
    "build:lucide": "node scripts/build-lucide.mjs",
    "watch": "tailwindcss -i ./public/assets/css/input.css -o ./public/assets/css/style.css --watch",
    "dev": "tailwindcss -i ./public/assets/css/input.css -o ./public/assets/css/style.css --watch",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "lucide": "0.469.0",
    "postcss": "^8.4.49",
    "@playwright/test": "^1.55.0",
    "tailwindcss": "^3.4.17"
  }
}
