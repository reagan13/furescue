# FurEscue integration-test environment.
# Copy to `.env.test` (git-ignored). Never point this at the demo `furescue` database.

# --- Database (dedicated test schema) ---
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=furescue_test
DB_USER=furescue
DB_PASS=change_me

# --- App ---
APP_ENV=testing
APP_TESTING=1
APP_SECRET=test_app_secret
JWT_SECRET=test_jwt_secret
JWT_REFRESH_SECRET=test_refresh_secret
JWT_ALGO=HS256
JWT_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7

# --- Google Sign-In (unused by automated tests) ---
GOOGLE_CLIENT_ID=834001682148-4ihrmh94oeob559qotfqaqbjkidrth3a.apps.googleusercontent.com

# --- IoT device API key for /vitals ingest (X-Device-Key header) ---
DEVICE_API_KEY=test_device_api_key

# --- Report duplicate-detection tuning ---
DEDUP_RADIUS_METERS=50
DEDUP_TIME_WINDOW_HOURS=24

# --- Mati City bounding box for geovalidation (lat/lng) ---
MATI_LAT_MIN=6.89
MATI_LAT_MAX=7.01
MATI_LNG_MIN=126.13
MATI_LNG_MAX=126.27

# --- CORS: PHP pages + Flutter web ---
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8080

# --- Dev DB viewer ---
DEVTOOL_KEY=test_devtool_key
