{
  "name": "furescue/backend",
  "description": "FURescue (Spot) backend - vanilla PHP REST API (PDO + MySQL)",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "vlucas/phpdotenv": "^5.6",
    "firebase/php-jwt": "^6.10"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php vendor/phpunit/phpunit/phpunit",
    "test:mysql": "php vendor/phpunit/phpunit/phpunit -c phpunit.mysql.xml.dist",
    "test:live": "php vendor/phpunit/phpunit/phpunit -c phpunit.live.xml.dist"
  },
  "config": {
    "sort-packages": true,
    "policy": {
      "advisories": {
        "ignore-id": ["PKSA-y2cr-5h3j-g3ys"]
      }
    }
  }
}
